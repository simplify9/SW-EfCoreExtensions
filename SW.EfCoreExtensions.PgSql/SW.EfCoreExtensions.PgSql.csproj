<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <PackageId>SimplyWorks.EfCoreExtensions.PgSql</PackageId>
    <Authors>Simplify9</Authors>
    <Product>SimplyWorks.EfCoreExtensions.PgSql</Product>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/simplify9/EfCoreExtensions</PackageProjectUrl>
    <RepositoryUrl>https://github.com/simplify9/EfCoreExtensions</RepositoryUrl>
    <PackageIcon>icon.png</PackageIcon>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
    <PackageReference Include="SimplyWorks.PrimitiveTypes" Version="10.0.1" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" Version="10.0.14" />
  </ItemGroup>

  <ItemGroup>
    <!-- Searchy is provider-neutral apart from SearchyTextMatch.cs, so the source is shared with the core package. -->
    <Compile Include="..\SW.EfCoreExtensions\Searchy\**\*.cs" LinkBase="Searchy" />
    <!-- Provider-neutral query shaping (projection rows, keyset paging, capped counts). -->
    <Compile Include="..\SW.EfCoreExtensions\Querying\**\*.cs" LinkBase="Querying" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\icon.png">
      <Pack>True</Pack>
      <PackagePath></PackagePath>
    </None>
  </ItemGroup>

</Project>
